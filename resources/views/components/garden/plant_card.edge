<article class="group overflow-hidden rounded-2xl border border-[#dbe3d7] bg-white p-4 shadow-sm transition duration-200 hover:scale-[1.01] hover:shadow-lg md:p-5">
  <!-- Image Section -->
  <div class="relative overflow-hidden rounded-xl {{ card.healthStatus === 'diseased' ? 'bg-red-100/20' : 'bg-[#f5f7f3]' }}">
    @if(card.plant.photo_path)
      <img src="{{ card.plant.photo_path }}" alt="{{ card.plant.name }}" class="aspect-4/3 w-full object-cover transition duration-300 group-hover:scale-105" />
    @else
      <div class="aspect-4/3 flex items-center justify-center text-[#7a8f7a]">
        <span class="text-sm font-medium">No Image</span>
      </div>
    @endif

    <!-- Status Badge -->
    <div class="absolute left-3 top-3 rounded-full px-3 py-1 text-xs font-semibold
      {{
        card.healthStatus === 'healthy'
          ? 'bg-green-100 text-green-700'
          : card.healthStatus === 'diseased'
            ? 'bg-red-100 text-red-700'
            : 'bg-yellow-100 text-yellow-700'
      }}">
      @if(card.healthStatus === 'healthy')
        Healthy
      @elseif(card.healthStatus === 'diseased')
        Warning: {{ card.latestDetection.diseaseName }}
      @else
        Warning
      @endif
    </div>
  </div>

  <!-- Content Section -->
  <div class="mt-4">
    <h3 class="text-xl font-bold text-[#0A5436]">{{ card.plant.name }}</h3>
    <p class="mt-1 text-xs uppercase tracking-[0.16em] text-[#6a7b70]">{{ card.plant.type }}</p>

    <!-- Metadata Cards -->
    <div class="mt-4 grid grid-cols-2 gap-3">
      <div class="rounded-xl border border-[#e4ebdf] bg-[#fbfdf9] p-3">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#6a7b70]">Terakhir Disiram</p>
        <p class="mt-1 text-sm font-semibold text-[#14573e]">{{ card.lastWateringLabel }}</p>
      </div>
      <div class="rounded-xl border border-[#e4ebdf] bg-[#fbfdf9] p-3">
        <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#6a7b70]">Deteksi Terakhir</p>
        <p class="mt-1 text-sm font-semibold text-[#14573e]">
          {{ card.latestDetection
            ? new Date(card.latestDetection.createdAt).toLocaleString('id-ID', {
              timeZone: 'Asia/Jakarta',
              hour12: false
            })
            : 'Belum ada' }}
        </p>
      </div>
    </div>

    <!-- Last Scan Result Section -->
    <div class="mt-4 rounded-xl {{ card.healthStatus === 'diseased' ? 'border-red-200 bg-red-50/50' : 'border-[#e4ebdf] bg-[#f8faf6]' }} border p-3">
      <p class="text-[11px] font-semibold uppercase tracking-[0.12em] {{ card.healthStatus === 'diseased' ? 'text-red-600' : 'text-[#6a7b70]' }}">Last Scan Result</p>
      @if(card.latestDetection)
        <p class="mt-2 text-sm font-semibold {{ card.healthStatus === 'diseased' ? 'text-red-700' : 'text-[#0A5436]' }}">{{ card.latestDetection.diseaseName }}</p>
        <p class="mt-1 text-xs text-[#6a7b70]">
          Confidence: {{ card.latestDetection.confidence !== null ? `${card.latestDetection.confidence}%` : 'N/A' }}
          - {{ new Date(card.latestDetection.createdAt).toLocaleString('id-ID', {
            timeZone: 'Asia/Jakarta',
            hour12: false
          }) }}
        </p>
      @else
        <p class="mt-2 text-sm text-[#6a7b70]">Belum ada hasil scan.</p>
      @endif
    </div>

    <!-- Plant Info Link (if diseased) -->
    @if(card.healthStatus === 'diseased')
      <a href="/plant_info/?plant={{ card.plant.id }}&disease={{ card.latestDetection.diseaseName }}" class="mt-4 flex items-center justify-center gap-2 rounded-lg border border-blue-200 bg-blue-50/40 px-3 py-2 text-sm font-semibold text-blue-700 transition duration-200 hover:bg-blue-50">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Lihat Detail
      </a>
    @endif

    <!-- Action Buttons -->
    <div class="mt-4 flex flex-col gap-2">
      <!-- Primary: Scan Disease (Full Width) -->
      <button
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#3FAB5E] px-4 py-3 text-sm font-semibold text-white transition duration-200 hover:bg-[#368F4F]"
        onclick="window.openScanDisease('{{ card.plant.id }}', '{{ card.plant.name }}')"
        title="Scan Disease"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.868v4.264a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Pindai Penyakit
      </button>

      <!-- Secondary: Treat Now (if diseased) -->
      @if(card.healthStatus === 'diseased')
        <button
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-orange-300 bg-orange-50 px-4 py-2 text-sm font-semibold text-orange-700 transition duration-200 hover:bg-orange-100"
          onclick="window.showConfirmModal('pesticide', '{{ card.plant.id }}', '{{ card.plant.name }}')"
          title="Treat Now"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m0 0h6m-6 0h-6" />
          </svg>
          Rawat Sekarang
        </button>
      @endif

      <!-- Tertiary: Water & Harvest (Smaller, Outlined) -->
      <div class="grid grid-cols-2 gap-2">
        <button
          class="inline-flex items-center justify-center gap-1 rounded-lg border border-[#b7dcbc] bg-[#eef9f1] px-3 py-2 text-xs font-semibold text-[#1f8c4d] transition duration-200 hover:bg-[#dff2e5]"
          onclick="window.showConfirmModal('water', '{{ card.plant.id }}', '{{ card.plant.name }}')"
          title="Water"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v2m0 0C7.03 7.39 4 11.28 4 15a8 8 0 0016 0c0-3.72-3.03-7.61-8-10z" />
          </svg>
          Siram
        </button>

        <button
          class="inline-flex items-center justify-center gap-1 rounded-lg border border-[#b7cfb9] bg-white px-3 py-2 text-xs font-semibold text-[#14573e] transition duration-200 hover:bg-[#f3f8f0]"
          onclick="window.showConfirmModal('harvest', '{{ card.plant.id }}', '{{ card.plant.name }}')"
          title="Harvest"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Panen
        </button>
      </div>
    </div>
  </div>
</article>
