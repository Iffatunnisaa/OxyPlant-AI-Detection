<article id="{{ crop.id }}" class="group overflow-hidden rounded-4xl border border-[#dbe3d7] bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl scroll-mt-28">
  <div class="grid grid-cols-1 lg:grid-cols-[1.08fr_0.92fr]">
    <div class="p-6 md:p-8 lg:p-9">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6a7b70]">{{ crop.category }}</p>
          <h3 class="mt-1 text-2xl font-bold text-[#0f4a34] md:text-3xl">{{ crop.name }}</h3>
        </div>
      </div>

      <p class="mt-4 max-w-2xl text-base leading-relaxed text-[#4d6056]">
        {{ crop.description }}
      </p>

      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        @each(item in crop.care)
          <div class="rounded-3xl border border-[#dfe6db] bg-[#fbfcf8] p-4 transition duration-200 group-hover:border-[#c8d8c2]">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#6a7b70]">{{ item.label }}</p>
            <p class="mt-2 text-sm leading-relaxed text-[#174c37]">{{ item.value }}</p>
          </div>
        @endeach
      </div>

      <div class="mt-7">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6a7b70]">Penyakit umum</p>
            <h4 class="mt-1 text-lg font-bold text-[#0f4a34]">Kenali tanda-tanda gejalanya sejak dini.</h4>
          </div>
        </div>

        <div class="mt-4 grid gap-3" data-disease-container="{{ crop.id }}">
          @each((disease, index) in crop.diseases)
            @if(index < 3)
              <div class="disease-item rounded-3xl border border-[#dfe6db] bg-[#f8faf5] p-4 transition duration-200 hover:border-[#c8d8c2]"
                   data-index="{{ index }}">
                <div class="flex items-start justify-between gap-3">
                  <p class="font-semibold text-[#14573e]">{{ disease.name }}</p>
                  <span class="shrink-0 rounded-full bg-[#fdeceb] px-2.5 py-1 text-[11px] font-semibold text-[#a33a3a]">Gejala</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-[#4d6056]">{{ disease.gejala }}</p>
              </div>
            @else
              <div class="disease-item rounded-3xl border border-[#dfe6db] bg-[#f8faf5] p-4 transition duration-200 hover:border-[#c8d8c2]"
                   data-index="{{ index }}"
                   data-hidden="true"
                   style="display: none;">
                <div class="flex items-start justify-between gap-3">
                  <p class="font-semibold text-[#14573e]">{{ disease.name }}</p>
                  <span class="shrink-0 rounded-full bg-[#fdeceb] px-2.5 py-1 text-[11px] font-semibold text-[#a33a3a]">Symptoms</span>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-[#4d6056]">{{ disease.gejala }}</p>
              </div>
            @endif
          @endeach

          @if(crop.diseases.length > 3)
            <div class="mt-2 text-center">
              <button class="toggle-diseases-btn inline-flex items-center text-sm font-semibold text-[#14573e] transition duration-200 hover:text-[#0f4a34] hover:underline"
                      data-crop-id="{{ crop.id }}"
                      data-expanded="false">
                <span class="view-more-text">View more ({{ crop.diseases.length - 3 }} more)</span>
                <span class="show-less-text hidden">Show less</span>
              </button>
            </div>
          @endif
        </div>
      </div>
    </div>

    <div class="relative min-h-72 overflow-hidden bg-linear-to-br from-[#14573e] via-[#174c37] to-[#0c3829] p-6 text-white md:p-8">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(255,255,255,0.16),transparent_42%),radial-gradient(circle_at_bottom_right,rgba(199,217,198,0.14),transparent_36%)]"></div>
      <div class="relative flex h-full flex-col justify-between gap-6">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="mt-1 text-lg font-semibold">{{ crop.name }}</p>
          </div>
          <div class="rounded-full border border-white/20 bg-white/10 px-3 py-1 text-xs font-semibold text-white/90 backdrop-blur">
            Fast review
          </div>
        </div>

        <div class="rounded-[1.75rem] border border-white/10 bg-white/10 p-4 backdrop-blur-sm">
          @if(crop.image)
            <img src="{{ crop.image }}" alt="{{ crop.name }}" class="mx-auto h-55 w-full max-w-72 object-contain drop-shadow-2xl">
          @else
            <div class="flex aspect-4/3 items-center justify-center rounded-3xl border border-white/10 bg-white/10 text-center">
              <div>
                <p class="text-5xl font-bold tracking-tight">{{ crop.shortName }}</p>
                <p class="mx-auto mt-3 max-w-45 text-sm leading-relaxed text-white/80">
                  Visual placeholder for quick recognition.
                </p>
              </div>
            </div>
          @endif
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70">Penggunaan terbaik</p>
            <p class="mt-2 text-sm leading-relaxed text-white/90">Bandingkan gejala yang terdeteksi oleh AI dengan catatan perawatan di sebelah kiri.</p>
          </div>
          <div class="rounded-3xl border border-white/10 bg-white/10 p-4 backdrop-blur-sm">
            <p class="mt-2 text-sm leading-relaxed text-white/90">Cara yang lebih cepat untuk mengetahui apa yang dibutuhkan tanaman sebelum masalah menyebar.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</article>
