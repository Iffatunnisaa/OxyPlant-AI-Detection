@layout.auth({ title: "Daftar | OxyPlant" })
  @slot('body')

  <div class="min-h-screen flex flex-col md:flex-row">
    <!-- Bagian kiri: Background Gambar Daun -->
     <div
     class="hidden md:block md:w-1/2 bg-cover bg-center"
    data-oxyplant-asset="d2"
     >
    </div>

    <!-- Bagian kanan: Form Register -->
     <div class="w-full md:w-1/2 flex items-center justify-center min-h-screen p-12 md:p-14 bg-[#F2F1EB]">
      <div class="w-full max-w-sm md:max-w-xl lg:max-w-xl p-6 md:p-8 rounded-xl">
        <!-- Title -->
         <div class="text-center mb-6">
          <h2 class="text-2xl md:text-3xl font-bold text-green-700 mb-2">
            Buat Akun OxyPlant
          </h2>
          <p class="text-gray-600 text-sm md:text-base">
            Satu akun untuk semua produk Garden OxyPlant
          </p>
         </div>

         <form 
         class="space-y-4"
         method="post"
         action="{{ route('auth.register.post') }}"
         >
        {{ csrfField() }}

        <!-- Nama Lengkap -->
         <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
            <input 
            type="text"
            name="fullname"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none"
            placeholder="Nama Lengkap Anda"
            />
          </div>
        
        <!-- Username -->
         <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
            <input 
            type="text"
            name="username"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none"
            placeholder="Username Unik"
            />
          </div>
        
        <!-- Email -->
         <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input 
            type="text"
            name="email"
            class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none"
            placeholder="email@gmail.com"
            />
          </div>
        
        <!-- Password -->
         <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Kata Sandi</label>
            <div class="relative">
              <input 
              type="password"
              name="password"
              id="password"
              class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-green-400 focus:outline-none"
              placeholder="••••••••"
              />

              <button
              type="button"
              onclick="togglePassword()"
              class="absolute inset-y-0 right-3 flex items-center text-gray-500"
              >
              <span id="eye-icon">🔒</span>
              </button>
            </div>
          </div>

          <!-- Button Submit -->
            <div class="mt-auto text-center">
              <button type="submit"
              class="w-full max-w-xs bg-linear-to-r from-green-500 to-green-600 text-white py-2.5 rounded-lg hover:from-green-600 hover:to-green-700 transition"
              >
              Masuk
              </button>
            </div>

      </form>

      <!-- Login -->
       <div class="text-center mt-6">
        <p class="text-sm text-gray-600">
          Sudah Punya Akun?
          <a href="{{ route('auth.login') }}" class="text-green-700 font-medium hover:underline">
            Masuk Disini
          </a>
        </p>
       </div>
      </div>
     </div>
  </div>

  @endslot
     @slot('script')
     <script>
      function togglePassword(inputId, iconId) {
        const passwordInput = document.getElementById("password");
        const eyeIcon = document.getElementById("eye-icon");
        if (passwordInput.type === "password") {
          passwordInput.type = "text";
          eyeIcon.innerHTML = "👁️";
        } else {
          passwordInput.type = "password";
          eyeIcon.innerHTML = "🔒";
        }
      }
      // Auto-focus email field
      
      document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("email")?.focus();
      });
     </script>
     @endslot
@end
