    >
    </div>

    <!-- Bagian Kanan: Form Login -->
     <div class="w-full md:w-1/2 flex items-center justify-center min-h-screen p-12 md:p-14 bg-[#F2F1EB]">
      <div class="w-full max-w-sm md:max-w-xl lg:max-w-xl p-6 md:p-8 rounded-xl ">
        <!-- Title -->
         <div class="text-center mb-6">
          <h2 class="text-2xl md:text-3xl font-bold text-green-700 mb-2">
            Masuk ke Akun OxyPlant
          </h2>
