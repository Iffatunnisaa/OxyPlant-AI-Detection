@layout.app({ title: 'Komunitas | OxyPlant' })
  @slot('main')
    <main class="min-h-screen bg-[radial-gradient(circle_at_top_left,rgba(15,74,52,0.10),transparent_34%),linear-gradient(180deg,#f5f7f2_0%,#eef3ec_100%)] text-[#17352a]">
      <section class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8 lg:py-10">
        <div class="overflow-hidden rounded-[28px] border border-[#d7e2d6] bg-white/92 shadow-[0_24px_70px_rgba(15,74,52,0.08)] backdrop-blur">
          <div class="border-b border-[#e7eee4] bg-[linear-gradient(135deg,#ecf6e8_0%,#ffffff_42%,#f8fbf7_100%)] px-5 py-6 sm:px-6 lg:px-8 lg:py-8">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
              <div class="max-w-3xl">
                <span class="inline-flex items-center rounded-full border border-[#cfe0d0] bg-white px-3 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-[#14573e] shadow-sm">
                  Komunitas OxyPlant
                </span>
                <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#0f4a34] sm:text-4xl">Komunitas diskusi tanaman</h1>
                <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[#5e6d63] sm:text-base">
                  Berbagi kasus, minta konfirmasi, atau beri peringatan dengan tampilan yang ringkas di mobile dan nyaman dibaca di desktop.
                </p>
              </div>
              <div>
                <button id="share-detection" class="inline-flex items-center justify-center rounded-2xl bg-[#14573e] px-4 py-2.5 text-sm font-semibold text-white transition duration-200 hover:bg-[#0f4a34] hover:shadow-md">
                  Bagikan hasil
                </button>
              </div>
            </div>
          </div>

          <section class="border-b border-[#e7eee4] px-5 py-5 sm:px-6 lg:px-8">
            <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h2 class="text-base font-semibold text-[#0f4a34]">Deteksi privat siap dibagikan</h2>
                <p class="mt-1 text-sm text-[#6a7b70]">Pilih 1 hasil lalu tulis konteks diskusi sebelum dipublikasikan.</p>
              </div>
              <span class="text-xs uppercase tracking-[0.14em] text-[#6a7b70]">Flow: deteksi -> komentar -> publish</span>
            </div>
            @if(shareCandidates && shareCandidates.length)
              <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                @each(item in shareCandidates)
                  <article class="rounded-2xl border border-[#dbe3d7] bg-[#fbfcfa] p-3 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_16px_40px_rgba(15,74,52,0.08)]">
                    <div class="flex items-start gap-3">
                      <img src="{{ item.imageUrl || 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' }}" data-oxyplant-asset="plant" alt="preview" class="h-14 w-14 shrink-0 rounded-xl object-cover" />
                      <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-semibold text-[#0f4a34]">{{ item.plant_name || 'Tanaman' }}</p>
                        <p class="truncate text-xs text-[#6a7b70]">{{ item.disease_name || 'Hasil deteksi' }}</p>
                        <p class="mt-1 text-xs text-[#4d6056]">Confidence {{ item.confidenceLabel }}</p>
                      </div>
                    </div>
                    <button
                      type="button"
                      class="share-trigger mt-3 w-full rounded-xl bg-[#14573e] px-3 py-2 text-xs font-semibold text-white transition duration-200 hover:bg-[#0f4a34]"
                      data-detection-id="{{ item._id }}"
                    >
                      Share ke Community
                    </button>
                  </article>
                @endeach
              </div>
            @else
              <div class="rounded-2xl border border-dashed border-[#cfd8cd] bg-[#f8fbf7] p-5 text-sm text-[#6a7b70]">
                Kamu belum punya hasil deteksi privat terbaru untuk dibagikan.
              </div>
            @endif
          </section>

          <div class="grid gap-6 px-5 py-5 sm:px-6 lg:grid-cols-[minmax(0,1fr)_320px] lg:px-8">
            <section>
              <div class="mb-4 flex flex-col gap-3 rounded-2xl border border-[#dbe3d7] bg-[#fbfcfa] p-4 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex w-full flex-col gap-2 sm:flex-row sm:items-center">
                  <select id="filter" class="w-full rounded-xl border border-[#dbe3d7] bg-white px-3 py-2 text-sm text-[#355044] outline-none transition duration-200 focus:border-[#3FAB5E] focus:ring-2 focus:ring-[#3FAB5E]/20 sm:w-52">
                    <option value="latest">Terbaru</option>
                    <option value="most_discussed">Paling banyak diskusi</option>
                    <option value="critical">Kasus kritis</option>
                    <option value="unanswered">Belum terjawab</option>
                  </select>
                  <input id="plant-filter" type="text" placeholder="Filter tanaman (contoh: Tomat)" class="w-full rounded-xl border border-[#dbe3d7] bg-white px-3 py-2 text-sm text-[#355044] outline-none transition duration-200 placeholder:text-gray-400 focus:border-[#3FAB5E] focus:ring-2 focus:ring-[#3FAB5E]/20" />
                </div>
                <div class="text-sm text-[#6a7b70]">Menampilkan <strong class="text-[#0f4a34]">{{ posts.length || 0 }}</strong> postingan</div>
              </div>

              <div class="space-y-4">
                @if(posts && posts.length)
                  @each(post in posts)
                    @include('pages/community/components/community_card')
                  @endeach
                @else
                  @include('pages/community/components/empty_state')
                @endif
              </div>
            </section>

            <aside class="space-y-4 lg:sticky lg:top-6 lg:self-start">
              <div class="rounded-2xl border border-[#dbe3d7] bg-white p-4 shadow-sm">
                <h3 class="font-semibold text-[#0f4a34]">Aktivitas terbaru</h3>
                <p class="mt-2 text-sm leading-relaxed text-[#6a7b70]">Ringkasan interaksi komunitas.</p>
              </div>
            </aside>
          </div>
        </div>
      </section>

      @include('pages/community/components/share_modal')
    </main>
  @endslot
@end
