<article class="group overflow-hidden rounded-2xl border border-[#dbe3d7] bg-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_45px_rgba(15,74,52,0.08)]">
  <div class="grid gap-4 p-4 sm:grid-cols-[112px_minmax(0,1fr)] sm:items-start sm:p-5">
    <img src="{{ post.sourceImageUrl || post.coverImageUrl || post.coverPath || 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' }}" data-oxyplant-asset="plant" alt="cover" class="h-24 w-full rounded-2xl object-cover sm:h-full sm:min-h-28" />
    <div class="min-w-0">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
          <h3 class="text-lg font-semibold leading-snug text-[#0f4a34] line-clamp-2">{{ post.title }}</h3>
          <div class="mt-1 text-sm text-[#6a7b70]">{{ post.plantName || 'Tanaman' }} · {{ post.diseaseLabel || '-' }}</div>
        </div>
        <div class="shrink-0 text-right text-sm">
          <div class="text-[#4d6056]">{{ post.feedbackCount || 0 }} komentar</div>
          <div class="text-[#8a938d]">{{ post.createdAtLabel || '-' }}</div>
        </div>
      </div>

      <p class="mt-3 text-sm leading-relaxed text-[#355044] line-clamp-3">{{ post.body || 'Belum ada konteks diskusi yang ditulis.' }}</p>

      <div class="mt-4 flex flex-col gap-3 border-t border-[#edf1ea] pt-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-[#dbe3d7] bg-[#f8fbf7] px-2.5 py-1 text-xs font-medium text-[#355044]">{{ post.discussionType || 'Diskusi' }}</span>
          <span class="text-xs text-[#6a7b70]">Confidence: {{ post.confidenceLabel ?? post.confidence ?? '-' }}%</span>
        </div>
        <div class="flex items-center gap-2">
          <a href="{{ route('community.show', { id: post.slug || post._id }) }}" class="inline-flex items-center justify-center rounded-xl border border-[#cfe0d0] bg-white px-4 py-2 text-sm font-semibold text-[#14573e] transition duration-200 hover:border-[#14573e] hover:bg-[#f4faf5]">Buka</a>
        </div>
      </div>
    </div>
  </div>
</article>
