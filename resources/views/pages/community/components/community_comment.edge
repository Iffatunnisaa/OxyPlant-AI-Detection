<article class="rounded-lg border bg-white p-3">
  <div class="flex items-start gap-3">
    <div class="h-9 w-9 rounded-full bg-gray-100 flex items-center justify-center text-sm font-semibold">{{ comment.user?.fullname?.charAt(0) || 'U' }}</div>
    <div class="flex-1">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-semibold text-gray-900">{{ comment.user?.fullname || comment.user?.username || 'Anonim' }}</p>
          <p class="text-xs text-gray-500">{{ new Date(comment.createdAt).toLocaleString() }}</p>
        </div>
      </div>
      <p class="mt-2 text-sm text-gray-700">{{ comment.body }}</p>
    </div>
  </div>
</article>
