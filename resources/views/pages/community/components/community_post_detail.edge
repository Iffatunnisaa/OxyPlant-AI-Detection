<div class="mx-auto w-full max-w-4xl">
  <div class="overflow-hidden rounded-3xl border border-[#dbe3d7] bg-white shadow-sm">
    <div class="border-b border-[#edf1ea] px-5 py-5 sm:px-6">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#6a7b70]">Diskusi Komunitas</p>
      <h2 class="mt-2 text-2xl font-bold text-[#0f4a34]">{{ post.title }}</h2>
      <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-[#5e6d63]">
        <span class="rounded-full border border-[#dbe3d7] bg-[#f8faf5] px-3 py-1">{{ post.plantName || 'Tanaman' }}</span>
        <span class="rounded-full border border-[#dbe3d7] bg-[#f8faf5] px-3 py-1">{{ post.diseaseLabel || 'Hasil deteksi' }}</span>
        <span class="rounded-full border border-[#dbe3d7] bg-[#f8faf5] px-3 py-1">Confidence {{ post.confidence ?? '-' }}%</span>
        <span class="rounded-full border border-[#dbe3d7] bg-[#f8faf5] px-3 py-1">{{ post.discussionType || 'Diskusi' }}</span>
      </div>
    </div>

    <div class="grid gap-6 px-5 py-5 sm:px-6 lg:grid-cols-[1.05fr_.95fr] lg:items-start">
      <div class="space-y-4">
        <div class="overflow-hidden rounded-2xl border border-[#dbe3d7] bg-[#f8faf5]">
          <img src="{{ post.sourceImageUrl || post.coverImageUrl || post.coverPath || '/resources/img/plant.jpeg' }}" alt="cover" class="h-72 w-full object-cover" />
        </div>

        <div class="rounded-2xl border border-[#dbe3d7] bg-[#fbfcfa] p-4">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#6a7b70]">Konteks yang ditulis pengguna</p>
          <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-[#355044]">{{ post.body || 'Belum ada konteks diskusi yang ditulis.' }}</p>
        </div>

        <div class="rounded-2xl border border-[#dbe3d7] bg-white p-4">
          <div class="flex items-center justify-between gap-3">
            <div>
              <h3 class="text-base font-semibold text-[#0f4a34]">Balasan komunitas</h3>
              <p class="mt-1 text-sm text-[#6a7b70]">Tulis komentar, konfirmasi, atau saran yang membantu pemilik tanaman.</p>
            </div>
            <span class="rounded-full border border-[#dbe3d7] bg-[#f8faf5] px-3 py-1 text-xs font-semibold text-[#4d6056]">{{ post.feedbackCount || 0 }} komentar</span>
          </div>

          <div id="comments-list" class="mt-4 space-y-3">
            <div class="rounded-2xl border border-dashed border-[#dbe3d7] bg-[#f8faf5] px-4 py-6 text-sm text-[#6a7b70]">
              Komentar akan dimuat dari endpoint komentar. Untuk sekarang, kolom interaksi ada di bawah.
            </div>
          </div>
        </div>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-6">
        <div class="rounded-2xl border border-[#dbe3d7] bg-[#f8faf5] p-4">
          <h3 class="text-base font-semibold text-[#0f4a34]">Tulis komentar</h3>
          <p class="mt-1 text-sm text-[#6a7b70]">Di sinilah pengguna lain bisa menanggapi isi post.</p>

          @if(currentUser)
            <form method="POST" action="{{ route('community.comments.store', { id: post._id }) }}" class="mt-4 space-y-4">
              {{ csrfField() }}
              <textarea
                name="body"
                rows="5"
                class="w-full rounded-2xl border border-[#dbe3d7] bg-white px-4 py-3 text-sm text-gray-800 outline-none transition duration-200 placeholder:text-gray-400 focus:border-[#3FAB5E] focus:ring-2 focus:ring-[#3FAB5E]/20"
                placeholder="Tulis pertanyaan, konfirmasi, pengalaman, atau saran..."
                required
              ></textarea>
              <button type="submit" class="inline-flex w-full items-center justify-center rounded-2xl bg-[#14573e] px-4 py-3 text-sm font-semibold text-white transition duration-200 hover:bg-[#0f4a34]">
                Kirim komentar
              </button>
            </form>
          @else
            <div class="mt-4 rounded-2xl border border-dashed border-[#cfd8cd] bg-white px-4 py-5 text-center">
              <p class="text-sm font-semibold text-[#0f4a34]">Masuk dulu untuk berinteraksi.</p>
              <a href="{{ route('auth.login') }}" class="mt-3 inline-flex items-center rounded-xl bg-[#14573e] px-4 py-2.5 text-sm font-semibold text-white transition duration-200 hover:bg-[#0f4a34]">
                Login
              </a>
            </div>
          @endif
        </div>

        <div class="rounded-2xl border border-[#dbe3d7] bg-white p-4">
          <h3 class="text-base font-semibold text-[#0f4a34]">Saran interaksi</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[#5e6d63]">
            <li>• Beri jawaban yang spesifik pada gejala, bukan komentar umum.</li>
            <li>• Jika pernah punya kasus serupa, ceritakan hasil tindakanmu.</li>
            <li>• Gunakan bahasa yang membantu pemilik tanaman mengambil tindakan.</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</div>
