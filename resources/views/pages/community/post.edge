<script>
  const postId = '{{ post._id }}'
  const commentsList = document.getElementById('comments-list')

  async function loadComments() {
    try {
      const response = await fetch(`/community/${postId}/comments`)
      const data = await response.json()

      if (!data.data || data.data.length === 0) {
        commentsList.innerHTML = `
          <div class="rounded-3xl border border-dashed border-[#dbe3d7] bg-[#f8fbf7] px-4 py-10 text-center">
            <p class="text-sm font-medium text-[#6a7b70]">
              Belum ada komentar
            </p>

            <p class="mt-2 text-xs text-[#9db0a6]">
              Jadilah yang pertama berkomentar!
            </p>
          </div>
        `

        return
      }

      commentsList.innerHTML = data.data.map(comment => `
        <div class="rounded-3xl border border-[#e4ebe1] bg-white p-4 shadow-sm transition duration-200 hover:shadow-md">

          <div class="flex gap-3">

            <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-[#3FAB5E] to-[#1f7a45] shadow-sm">
              <span class="text-sm font-bold text-white">
                ${(comment.user?.fullname || 'U').charAt(0).toUpperCase()}
              </span>
            </div>

            <div class="flex-1">

              <div class="flex flex-wrap items-center gap-2">

                <p class="text-sm font-semibold text-[#123524]">
                  ${comment.user?.fullname || 'Pengguna Anonim'}
                </p>

                <span class="text-xs text-[#7b8f84]">
                  ${new Date(comment.createdAt).toLocaleDateString('id-ID', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </span>
              </div>

              <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-[#355044]">
                ${comment.body}
              </p>
            </div>
          </div>
        </div>
      `).join('')
    } catch (err) {
      console.error('Failed to load comments:', err)

      commentsList.innerHTML = `
        <div class="rounded-3xl border border-dashed border-red-200 bg-red-50 px-4 py-10 text-center">
          <p class="text-sm font-medium text-red-600">
            Gagal memuat komentar
          </p>
        </div>
      `
    }
  }

  loadComments()

  setInterval(loadComments, 5000)

  const commentForm = document.querySelector('form[action*="comments.store"]')

  if (commentForm) {
    commentForm.addEventListener('submit', function () {
      setTimeout(loadComments, 1000)
    })
  }
</script>

  @endslot
@end