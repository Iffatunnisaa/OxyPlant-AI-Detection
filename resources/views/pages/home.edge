      #main-nav.home-nav {
        background: linear-gradient(
          to bottom,
          rgba(3, 36, 24, 0.78),
          rgba(3, 36, 24, 0.42)
        );
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
        backdrop-filter: blur(6px);
      }

      #main-nav.home-nav .nav-brand,
      #main-nav.home-nav .nav-link,
      #main-nav.home-nav .nav-mobile-button,
      #main-nav.home-nav .nav-profile {
        color: #f1f0e9;
      }

      #main-nav.home-nav #mobile-menu {
