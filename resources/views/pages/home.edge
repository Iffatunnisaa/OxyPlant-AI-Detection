      }

      #main-nav.home-nav.is-scrolled {
        background-color: rgba(242, 241, 235, 0.95);
        box-shadow: 0 4px 18px rgba(10, 84, 54, 0.12);
        backdrop-filter: blur(8px);
      }

      #main-nav.home-nav.is-scrolled .nav-brand,
      #main-nav.home-nav.is-scrolled .nav-link,
      #main-nav.home-nav.is-scrolled .nav-mobile-button,
      #main-nav.home-nav.is-scrolled .nav-profile {
        color: #0a5436;
      }

      #main-nav.home-nav.is-scrolled #mobile-menu {
        background-color: rgba(242, 241, 235, 0.98);
      }

      .hero-grid {
        min-height: calc(100vh - 2rem);
      }

      .feature-card {
        border: 1px solid rgba(10, 84, 54, 0.08);
        transition: transform 220ms ease, box-shadow 220ms ease;
      }

      .feature-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 14px 30px rgba(10, 84, 54, 0.14);
      }

      .section-kicker {
        letter-spacing: 0.14em;
      }

      @media (max-width: 768px) {
        .hero-grid {
          min-height: auto;
        }
      }
    </style>
  @endslot

