  @slot('script')
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const toggleButtons = document.querySelectorAll('.toggle-diseases-btn');

        toggleButtons.forEach(button => {
          button.addEventListener('click', function(e) {
            e.preventDefault();
            const cropId = this.dataset.cropId;
            const container = document.querySelector(`[data-disease-container="${cropId}"]`);
            const diseaseItems = container.querySelectorAll('.disease-item');
            const isExpanded = this.dataset.expanded === 'true';

            diseaseItems.forEach((item, index) => {
              if (index >= 3) {
                if (isExpanded) {
                  // Collapse: hide items after 3rd
                  item.style.display = 'none';
                  item.dataset.hidden = 'true';
                } else {
                  // Expand: show all items
                  item.style.display = '';
                  delete item.dataset.hidden;
                }
              }
            });

            // Toggle button text and state
            const viewMoreText = this.querySelector('.view-more-text');
            const showLessText = this.querySelector('.show-less-text');

            if (isExpanded) {
              // Switch back to "View more"
              viewMoreText.classList.remove('hidden');
              showLessText.classList.add('hidden');
              this.dataset.expanded = 'false';
            } else {
              // Switch to "Show less"
              viewMoreText.classList.add('hidden');
              showLessText.classList.remove('hidden');
              this.dataset.expanded = 'true';
            }
          });
        });
      });
    </script>
  @endslot

@end
